    {
        "id": "a8d45128edbf2b59",
        "type": "comment",
        "z": "9dfae3c1d5d0d977",
        "name": "── ALERTAS CRÍTICOS (nível > 85%) ──",
        "info": "Filtra apenas mensagens com nível acima do threshold.\nPublica alerta no tópico mackenzie/lixeiras/alertas.",
        "x": 640,
        "y": 400,
        "wires": []
    },
    {
        "id": "81e1e12e957a4a3b",
        "type": "function",
        "z": "9dfae3c1d5d0d977",
        "name": "Verifica Alerta Crítico",
        "func": "if (msg.topic && msg.topic.indexOf('/alertas') !== -1) {\n    return null;\n}\n\nvar nivel = msg.payload.nivel;\nvar id = msg.payload.id;\nif (!id) {\n    var partes = msg.topic.split('/');\n    id = partes[partes.length - 1];\n}\n\nvar chave = 'alerta_' + id;\nvar ultimoAlerta = context.get(chave)  0;\nvar agora = Date.now();\n\nif (nivel >= 85 && (agora - ultimoAlerta) > 300000) {\n    context.set(chave, agora);\n    msg.payload = {\n        tipo: 'CRITICO',\n        lixeira: id,\n        local: msg.payload.local  '',\n        nivel: nivel,\n        mensagem: id + ' nivel critico: ' + nivel.toFixed(1) + '%',\n        timestamp: new Date().toISOString()\n    };\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 3,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 460,
        "wires": [
            [
                "34c93210f4085e7a",
                "e6f06a5b21f643fe",
                "3fc07f5016a8337e"
            ]
        ]
    },
