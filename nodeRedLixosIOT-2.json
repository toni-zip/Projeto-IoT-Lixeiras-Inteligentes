    {
        "id": "ecf97e2628ff1fac",
        "type": "comment",
        "z": "9dfae3c1d5d0d977",
        "name": "── DADOS PARA O DASHBOARD (Tela 2) ──",
        "info": "Agrega o estado de todas as lixeiras em um único objeto JSON\ne publica no tópico mackenzie/dashboard/status para o painel operacional.",
        "x": 640,
        "y": 580,
        "wires": []
    },
    {
        "id": "68343b1fe56d45f8",
        "type": "function",
        "z": "9dfae3c1d5d0d977",
        "name": "Agrega Estado Global",
        "func": "// Mantém estado de todas as lixeiras no contexto global\nvar estado = global.get('lixeiras_estado') || {};\nvar dados  = msg.payload;\n\nif (dados.id) {\n    estado[dados.id] = {\n        id:         dados.id,\n        local:      dados.local,\n        nivel:      dados.nivel,\n        distancia:  dados.distancia,\n        status:     dados.nivel >= 85 ? 'CRITICA'\n                  : dados.nivel >= 60 ? 'ATENCAO'\n                  : dados.nivel <= 10 ? 'VAZIA'\n                  : 'NORMAL',\n        updated_at: new Date().toISOString()\n    };\n    global.set('lixeiras_estado', estado);\n}\n\n// Monta resumo para o dashboard\nvar lista   = Object.values(estado);\nvar total   = lista.length;\nvar criticas = lista.filter(l => l.status === 'CRITICA').length;\nvar atencao  = lista.filter(l => l.status === 'ATENCAO').length;\nvar normais  = lista.filter(l => l.status === 'NORMAL').length;\nvar vazias   = lista.filter(l => l.status === 'VAZIA').length;\n\nmsg.payload = {\n    lixeiras:  lista,\n    resumo: {\n        total:    total,\n        criticas: criticas,\n        atencao:  atencao,\n        normais:  normais,\n        vazias:   vazias\n    },\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "x": 640,
        "y": 640,
        "wires": [
